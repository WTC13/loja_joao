<header class="hidden md:block bg-zinc-950 border-b border-zinc-900 sticky top-0 z-50">
    <div class="container w-[75%] mx-auto py-4">
        <div class="flex items-center justify-between gap-8">
            
            <div class="flex-shrink-0">
                <a href="/" class="flex items-center gap-2">
                    <img src="/img/lining.png" alt="Logo" class="h-10 w-auto object-contain">
                    <span class="text-white font-black text-2xl tracking-tighter uppercase hidden md:block">
                        João <span class="text-blue-500 italic">Store</span>
                    </span>
                </a>
            </div>

            <div class="hidden lg:flex flex-1 max-w-2xl relative group">
                <input type="text" 
                    placeholder="O que você está procurando hoje?" 
                    class="w-full bg-zinc-900 border border-zinc-800 text-zinc-300 text-sm py-3 px-12 rounded-2xl focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all placeholder:text-zinc-600">
                <i class="bi bi-search absolute left-4 top-1/2 -translate-y-1/2 text-zinc-500 group-focus-within:text-blue-500"></i>
                <button class="absolute right-3 top-1/2 -translate-y-1/2 bg-zinc-800 text-zinc-400 hover:text-white px-3 py-1 rounded-lg text-xs font-bold transition-colors">
                    Enter
                </button>
            </div>

            <div class="flex items-center gap-6">
                <nav class="hidden xl:flex items-center gap-6">
                    <a href="/produtos" class="text-xs font-bold uppercase tracking-widest text-zinc-400 hover:text-white transition-colors">Produtos</a>
                    <a href="/ofertas" class="text-xs font-bold uppercase tracking-widest text-orange-500 hover:text-orange-400 transition-colors">Ofertas %</a>
                </nav>

                <div class="h-6 w-[1px] bg-zinc-800 hidden xl:block"></div>

                <div class="flex items-center gap-4">
                    <a href="/perfil" class="text-zinc-400 hover:text-white transition-colors text-xl">
                        <i class="bi bi-person-circle"></i>
                    </a>
                    
                    <a href="/carrinho" class="relative group">
                        <div class="bg-blue-600/10 p-2.5 rounded-xl border border-blue-500/20 group-hover:bg-blue-600 group-hover:border-blue-600 transition-all duration-300">
                            <i class="bi bi-bag-check text-blue-500 group-hover:text-white text-xl"></i>
                        </div>
                        <span class="absolute -top-2 -right-2 bg-blue-600 text-white text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center border-2 border-zinc-950">
                            0
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-zinc-900/50 border-t border-zinc-900 py-2.5">
        <div class="container w-[75%] mx-auto flex items-center justify-between">
            
            <div class="flex items-center gap-2 cursor-pointer hover:opacity-80 transition-opacity">
                <i class="bi bi-geo-alt-fill text-blue-500"></i>
                <div class="flex flex-col">
                    <span class="text-[9px] text-zinc-500 font-bold uppercase leading-none">Entregar em</span>
                    <span class="text-[11px] text-zinc-200 font-bold tracking-wide">Informe seu CEP</span>
                </div>
            </div>

            <div class="hidden md:flex items-center gap-8">
                <a href="#" class="text-[10px] text-zinc-500 font-black uppercase tracking-tighter hover:text-white flex items-center gap-1">
                    <i class="bi bi-lightning-charge"></i> Lançamentos
                </a>
                <a href="#" class="text-[10px] text-zinc-500 font-black uppercase tracking-tighter hover:text-white">Raquetes</a>
                <a href="#" class="text-[10px] text-zinc-500 font-black uppercase tracking-tighter hover:text-white">Borrachas</a>
                <a href="#" class="text-[10px] text-zinc-500 font-black uppercase tracking-tighter hover:text-white">Acessórios</a>
            </div>

            <div class="hidden sm:block">
                <span class="text-[10px] font-black italic text-zinc-600 uppercase tracking-widest">
                    Frete Grátis acima de <span class="text-emerald-500">R$ 299</span>
                </span>
            </div>
        </div>
    </div>
</header>

<header class="block md:hidden bg-zinc-950 border-b border-zinc-900 sticky top-0 z-50">
    <div class="container w-[95%] mx-auto py-3">
        <div class="flex items-center gap-2 sm:gap-4">
            
            <div class="flex-shrink-0">
                <a href="/" class="flex items-center gap-1">
                    <img src="/img/lining.png" alt="Logo" class="h-7 sm:h-9 w-auto">
                    <span class="text-white font-black text-lg tracking-tighter uppercase hidden xl:block">
                        João<span class="text-blue-500 italic">Store</span>
                    </span>
                </a>
            </div>

            <div class="flex-1 relative group">
                <input type="text" placeholder="Buscar..." 
                    class="w-full bg-zinc-900 border border-zinc-800 text-zinc-300 text-[13px] py-2 pl-9 pr-3 rounded-xl focus:outline-none focus:border-blue-500 transition-all">
                <i class="bi bi-search absolute left-3 top-1/2 -translate-y-1/2 text-zinc-600 text-sm"></i>
            </div>

            <div class="flex items-center gap-2 sm:gap-4">
                <a href="/perfil" class="hidden md:block text-zinc-400 hover:text-white text-xl">
                    <i class="bi bi-person-circle"></i>
                </a>
                
                <a href="/carrinho" class="relative group">
                    <div class="bg-blue-600/10 p-2 rounded-lg border border-blue-500/20">
                        <i class="bi bi-bag-check text-blue-500 text-lg"></i>
                    </div>
                    <span class="absolute -top-1.5 -right-1.5 bg-blue-600 text-white text-[9px] font-black w-4 h-4 rounded-full flex items-center justify-center">
                        0
                    </span>
                </a>

                <button class="text-zinc-400 text-2xl p-1" onclick="toggleMenu()">
                    <i class="bi bi-list"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="bg-zinc-900/40 border-t border-zinc-900/60 py-1.5">
        <div class="container w-[95%] mx-auto flex items-center gap-2">
            <i class="bi bi-geo-alt-fill text-blue-500 text-[10px]"></i>
            <div class="flex items-center gap-1.5">
                <span class="text-[9px] text-zinc-500 font-bold uppercase whitespace-nowrap">Entregar em:</span>
                <span class="text-[9px] text-zinc-200 font-bold tracking-tight truncate">Informe seu CEP</span>
            </div>
        </div>
    </div>
</header>

<div id="mobile-menu" class="fixed inset-0 bg-black/95 z-[70] hidden backdrop-blur-md">
    <div class="flex justify-end p-6">
        <button onclick="toggleMenu()" class="text-white text-3xl"><i class="bi bi-x-lg"></i></button>
    </div>
    <nav class="flex flex-col items-center gap-8 text-white uppercase font-black tracking-widest pt-10">
        <a href="/" class="hover:text-blue-500">Home</a>
        <a href="/produtos" class="hover:text-blue-500">Produtos</a>
        <a href="/ofertas" class="text-orange-500">Ofertas %</a>
        <a href="/perfil" class="hover:text-blue-500">Minha Conta</a>
        <div class="w-20 h-1 bg-blue-600 rounded-full mt-4"></div>
    </nav>
</div>

